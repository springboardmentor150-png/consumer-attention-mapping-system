# ─── Consumer Attention Mapping System — Environment Variables ───
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file.

# ─── Database (PostgreSQL ONLY) ───
DATABASE_URL=postgresql+pg8000://postgres:YOUR_PASSWORD_HERE@your-host:6543/postgres

# ─── Authentication ───
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Dataset Paths ───
RPC_DATASET_PATH=datasets/rpc
SKU_DATASET_PATH=datasets/sku110k
COCO_DATASET_PATH=datasets/coco
MALL_DATASET_PATH=datasets/mall

# ─── Model Paths ───
PERSON_MODEL_PATH=models/yolo11n.pt
PRODUCT_MODEL_PATH=models/product_yolo11.pt
BEHAVIOR_MODEL_PATH=models/behavior_classifier.pkl
MODEL_PATH=models

# ─── Video / Upload Config ───
VIDEO_DATA_PATH=backend/uploads/videos
REPORTS_DIR=backend/uploads/reports
MAX_VIDEO_SIZE_MB=500

# ─── Detection Thresholds ───
PERSON_CONF_THRESHOLD=0.4
PRODUCT_CONF_THRESHOLD=0.35
IOU_THRESHOLD=0.45
FRAME_SAMPLE_RATE=5

# ─── Attention Estimation ───
GAZE_YAW_THRESHOLD=25.0
GAZE_PITCH_THRESHOLD=20.0
ATTENTION_MIN_DURATION=1.5
ZONE_PROXIMITY_THRESHOLD=0.15

# ─── CORS (comma-separated origins) ───
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Training (used by scripts/) ───
TRAIN_EPOCHS=100
TRAIN_BATCH_SIZE=16
TRAIN_IMGSZ=640
TRAIN_DEVICE=cpu
TRAIN_LR=0.01
